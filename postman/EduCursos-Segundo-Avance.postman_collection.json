{
  "info": {
    "name": "EduCursos - Segundo avance",
    "description": "Pruebas de registro, sesión, cursos, categorías, perfil y Cloudinary. La cookie de sesión se conserva automáticamente por Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "courseId",
      "value": "1"
    },
    {
      "key": "userId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Registro estudiante",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"full_name\":\"Ana López\",\"gender\":\"Femenino\",\"birth_date\":\"2001-04-20\",\"email\":\"ana@example.com\",\"password\":\"Curso*2026\",\"role\":\"estudiante\"}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "Iniciar sesión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"ana@example.com\",\"password\":\"Curso*2026\"}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "Consultar sesión",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/auth/me"
      }
    },
    {
      "name": "Listar categorías",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/categories"
      }
    },
    {
      "name": "Listar cursos",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/courses"
      }
    },
    {
      "name": "Filtrar cursos",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/courses?q=PHP&from=2026-01-01",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "courses"
          ],
          "query": [
            {
              "key": "q",
              "value": "PHP"
            },
            {
              "key": "from",
              "value": "2026-01-01"
            }
          ]
        }
      }
    },
    {
      "name": "Detalle de curso",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/courses/{{courseId}}"
      }
    },
    {
      "name": "Actualizar perfil",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"full_name\":\"Ana López\",\"gender\":\"Femenino\",\"birth_date\":\"2001-04-20\",\"avatar_url\":null}"
        },
        "url": "{{baseUrl}}/api/v1/profile"
      }
    },
    {
      "name": "Crear curso (sesión instructor/admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"PHP desde cero\",\"description\":\"Curso introductorio de PHP con prácticas y proyecto final.\",\"category_id\":1,\"price\":0,\"levels\":[{\"title\":\"Primeros pasos\",\"video_url\":\"https://www.youtube.com/watch?v=ysz5S6PUM-U\"}]}"
        },
        "url": "{{baseUrl}}/api/v1/courses"
      }
    },
    {
      "name": "Listar cuentas (sesión administrador)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/admin/users"
      }
    },
    {
      "name": "Crear categoría (sesión administrador)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Desarrollo\",\"description\":\"Cursos de desarrollo de software.\"}"
        },
        "url": "{{baseUrl}}/api/v1/categories"
      }
    },
    {
      "name": "Desbloquear usuario (sesión administrador)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/admin/users/{{userId}}/unlock"
      }
    },
    {
      "name": "Subir imagen a Cloudinary (sesión requerida)",
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/uploads/image"
      }
    },
    {
      "name": "Cerrar sesión",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/logout"
      }
    },
    {
      "name": "Inscripciones del estudiante (sesión estudiante)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/student/enrollments",
        "description": "Requiere iniciar sesión con una cuenta de estudiante. Devuelve las inscripciones propias."
      }
    },
    {
      "name": "Cursos del instructor (sesión instructor)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/instructor/courses",
        "description": "Requiere iniciar sesión como instructor. Devuelve solo los cursos de la cuenta actual."
      }
    },
    {
      "name": "Reporte de usuarios estudiantes (sesión administrador)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/admin/reports/users?role=estudiante",
        "description": "Requiere iniciar sesión como administrador. Devuelve el reporte de estudiantes activos."
      }
    }
  ]
}
