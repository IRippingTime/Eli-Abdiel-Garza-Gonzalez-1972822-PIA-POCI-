{
  "info": {
    "name": "EduCursos - Entrega final",
    "description": "Colección de avance final. Inicia sesión con el rol requerido antes de ejecutar cada ruta; Postman conserva la cookie PHP. Las solicitudes de pago son demostrativas y requieren confirmación manual.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "courseId",
      "value": "1"
    },
    {
      "key": "userId",
      "value": "1"
    },
    {
      "key": "enrollmentId",
      "value": "1"
    },
    {
      "key": "levelId",
      "value": "1"
    },
    {
      "key": "paymentId",
      "value": "1"
    },
    {
      "key": "recipientId",
      "value": "2"
    },
    {
      "key": "reviewId",
      "value": "1"
    },
    {
      "key": "categoryId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Registro estudiante",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"full_name\":\"Ana López\",\"gender\":\"Femenino\",\"birth_date\":\"2001-04-20\",\"email\":\"ana@example.com\",\"password\":\"Curso*2026\",\"role\":\"estudiante\"}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "Iniciar sesión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"ana@example.com\",\"password\":\"Curso*2026\"}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "Consultar sesión",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/auth/me"
      }
    },
    {
      "name": "Listar categorías",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/categories"
      }
    },
    {
      "name": "Listar cursos",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/courses"
      }
    },
    {
      "name": "Filtrar cursos",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/courses?q=PHP&from=2026-01-01",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "courses"
          ],
          "query": [
            {
              "key": "q",
              "value": "PHP"
            },
            {
              "key": "from",
              "value": "2026-01-01"
            }
          ]
        }
      }
    },
    {
      "name": "Detalle de curso",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/courses/{{courseId}}"
      }
    },
    {
      "name": "Actualizar perfil",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"full_name\":\"Ana López\",\"gender\":\"Femenino\",\"birth_date\":\"2001-04-20\",\"avatar_url\":null}"
        },
        "url": "{{baseUrl}}/api/v1/profile"
      }
    },
    {
      "name": "Crear curso (sesión instructor/admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"PHP desde cero\",\"description\":\"Curso introductorio de PHP con prácticas y proyecto final.\",\"category_id\":1,\"price\":0,\"levels\":[{\"title\":\"Primeros pasos\",\"video_url\":\"https://www.youtube.com/watch?v=ysz5S6PUM-U\"}]}"
        },
        "url": "{{baseUrl}}/api/v1/courses"
      }
    },
    {
      "name": "Listar cuentas (sesión administrador)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/admin/users"
      }
    },
    {
      "name": "Crear categoría (sesión administrador)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Desarrollo\",\"description\":\"Cursos de desarrollo de software.\"}"
        },
        "url": "{{baseUrl}}/api/v1/categories"
      }
    },
    {
      "name": "Desbloquear usuario (sesión administrador)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/admin/users/{{userId}}/unlock"
      }
    },
    {
      "name": "Subir imagen a Cloudinary (sesión requerida)",
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/uploads/image"
      }
    },
    {
      "name": "Cerrar sesión",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/logout"
      }
    },
    {
      "name": "Inscripciones del estudiante (sesión estudiante)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/student/enrollments",
        "description": "Requiere iniciar sesión con una cuenta de estudiante. Devuelve las inscripciones propias."
      }
    },
    {
      "name": "Cursos del instructor (sesión instructor)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/instructor/courses",
        "description": "Requiere iniciar sesión como instructor. Devuelve solo los cursos de la cuenta actual."
      }
    },
    {
      "name": "Reporte de usuarios estudiantes (sesión administrador)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/admin/reports/users?role=estudiante",
        "description": "Requiere iniciar sesión como administrador. Devuelve el reporte de estudiantes activos."
      }
    },
    {
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/student/enrollments",
        "body": {
          "mode": "raw",
          "raw": "{\"course_id\":{{courseId}}}"
        }
      },
      "name": "Inscribir curso gratuito"
    },
    {
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/student/enrollments/{{enrollmentId}}/progress",
        "body": {
          "mode": "raw",
          "raw": "{\"level_id\":{{levelId}}}"
        }
      },
      "name": "Registrar avance de nivel"
    },
    {
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/student/courses/{{courseId}}/purchase",
        "body": {
          "mode": "raw",
          "raw": "{\"payment_method\":\"transferencia\"}"
        }
      },
      "name": "Solicitar compra de curso"
    },
    {
      "request": {
        "url": "{{baseUrl}}/api/v1/instructor/sales?view=summary",
        "method": "GET"
      },
      "name": "Ventas resumen"
    },
    {
      "request": {
        "url": "{{baseUrl}}/api/v1/instructor/sales?view=detail",
        "method": "GET"
      },
      "name": "Ventas detalle"
    },
    {
      "request": {
        "url": "{{baseUrl}}/api/v1/messages/contacts",
        "method": "GET"
      },
      "name": "Contactos de mensajería"
    },
    {
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/messages",
        "body": {
          "mode": "raw",
          "raw": "{\"recipient_id\":{{recipientId}},\"body\":\"Tengo una pregunta sobre el curso.\"}"
        }
      },
      "name": "Enviar mensaje"
    },
    {
      "request": {
        "url": "{{baseUrl}}/api/v1/courses/{{courseId}}/reviews",
        "method": "GET"
      },
      "name": "Consultar opiniones de curso"
    },
    {
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/student/reviews",
        "body": {
          "mode": "raw",
          "raw": "{\"enrollment_id\":{{enrollmentId}},\"rating\":5,\"comment\":\"Buen curso.\"}"
        }
      },
      "name": "Publicar opinión"
    },
    {
      "request": {
        "url": "{{baseUrl}}/api/v1/admin/payments",
        "method": "GET"
      },
      "name": "Solicitudes de pago pendientes"
    },
    {
      "request": {
        "description": "Solo confirma después de verificar el pago fuera del sistema.",
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/admin/payments/{{paymentId}}/confirm"
      },
      "name": "Confirmar pago ya verificado"
    },
    {
      "request": {
        "url": "{{baseUrl}}/api/v1/admin/reviews",
        "method": "GET"
      },
      "name": "Listar comentarios para moderación"
    },
    {
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/admin/reviews/{{reviewId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"reason\":\"Contenido ofensivo\"}"
        }
      },
      "name": "Eliminar comentario con causa"
    },
    {
      "request": {
        "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}/deactivate",
        "method": "POST"
      },
      "name": "Dar de baja curso"
    },
    {
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/categories/{{categoryId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Diseño\",\"description\":\"Cursos de diseño.\"}"
        }
      },
      "name": "Editar categoría"
    },
    {
      "request": {
        "url": "{{baseUrl}}/api/v1/categories/{{categoryId}}",
        "method": "DELETE"
      },
      "name": "Eliminar categoría"
    }
  ]
}
